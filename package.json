{
  "name": "@nile-auth/package",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "install:server": "turbo install --filter=@nile-auth/server",
    "start:server": "turbo start --filter=@nile-auth/server",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "audit:security": "yarn npm audit --all --recursive --no-deprecations"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.2.5",
    "prettier-plugin-embed": "^0.4.15",
    "prettier-plugin-sql": "^0.18.1",
    "turbo": "^2.11.10",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "yarn@4.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "basic-ftp": "^6.2.3",
    "thirty-two@npm:^1.0.2": "patch:thirty-two@npm%3A1.0.2#./.yarn/patches/thirty-two-npm-1.0.2-9d9270aa34.patch"
  }
}
