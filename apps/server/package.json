{
  "name": "@nile-auth/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"$NODE_OPTIONS --trace-warnings --require ./tracing.cjs\" next dev --webpack -p 3001",
    "build": "next build --webpack",
    "build:spec": "yarn next-swagger-doc-cli openapi/next-swagger-doc.json && mv public/swagger.json openapi",
    "build:client": "yarn openapi-generator-cli generate -i openapi/swagger.json -g typescript-fetch -o openapi/region-rest --additional-properties=ngVersion=6.1.7,supportsES6=true,npmVersion=6.9.0,withInterfaces=true,typescriptThreePlus=true",
    "start": "NODE_OPTIONS=\"$NODE_OPTIONS --require ./tracing.cjs\" next start -p 3001",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:sql": "yarn build && jest --config jest.sql.config.js"
  },
  "dependencies": {
    "@nile-auth/core": "*",
    "@nile-auth/logger": "*",
    "@nile-auth/query": "*",
    "next": "^16.4.2",
    "next-swagger-doc": "^0.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swagger-ui-react": "^5.34.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@nile-auth/eslint-config": "workspace:*",
    "@nile-auth/typescript-config": "workspace:*",
    "@niledatabase/server": "^4.1.0",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^4.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "openapi-types": "^12.1.3",
    "otplib": "^12.0.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.5"
  }
}
